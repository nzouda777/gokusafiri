APP_NAME=GoKuSafiri
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gokusafiri
DB_USERNAME=gokusafiri
DB_PASSWORD=secret

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Cache / Session / Queue ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# --- Mail ---
# Options: mailpit | mailtrap | smtp | resend | log | array
MAIL_MAILER=mailpit
MAIL_FROM_ADDRESS="support@gokusafiri.com"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_EMAIL="${MAIL_FROM_ADDRESS}"

# Mailpit (Docker)  UI disponible sur http://localhost:8025
MAILPIT_HOST=mailpit
MAILPIT_PORT=1025

# Mailtrap sandbox  set MAIL_MAILER=mailtrap pour activer
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=

# SMTP générique (autres fournisseurs)
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_SCHEME=null
MAIL_USERNAME=null
MAIL_PASSWORD=null

# --- Socialite Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Paiement ---
PAYMENT_DRIVER=fake

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- Filament ---
FILAMENT_AUTH_GUARD=web

# --- Filesystem ---
FILESYSTEM_DISK=public
MEDIA_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

STRIPE_KEY=pk_test_your_publishable_key
STRIPE_SECRET=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=${APP_URL}/auth/google/callback

# AI chat widget — free-tier OpenAI-compatible provider ($0)
# Groq (default):      https://console.groq.com  -> CHAT_AI_KEY=gsk_...
# Google Gemini:       CHAT_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  CHAT_AI_MODEL=gemini-2.0-flash
# OpenRouter (free):   CHAT_AI_BASE_URL=https://openrouter.ai/api/v1  CHAT_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
CHAT_AI_PROVIDER=openai
CHAT_AI_KEY=
CHAT_AI_BASE_URL=https://api.groq.com/openai/v1
CHAT_AI_MODEL=llama-3.3-70b-versatile

# Optional paid alternative: set CHAT_AI_PROVIDER=anthropic and fill these
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
