# ─────────────────────────────────────────────────────────────────────────────
# .env.production.example  Configuration pour serveur mutualisé (sans Redis)
# Copie ce fichier, renomme-le .env sur le serveur, et remplis les valeurs.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="GokuSafiri"
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://gokusafiri.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=error

# ── Base de données ────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost              # sur mutualisé, c'est souvent localhost
DB_PORT=3306
DB_DATABASE=votre_db
DB_USERNAME=votre_user
DB_PASSWORD=votre_mot_de_passe

# ── Cache  FILE (mutualisé, pas de Redis) ────────────────────────────────────
# Nécessaire pour withoutOverlapping() dans le scheduler.
CACHE_STORE=file

# ── Sessions  FILE ou DATABASE ────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Queue  DATABASE (mutualisé, pas de Redis/Horizon) ───────────────────────
# Le scheduler (schedule:run) lance queue:work automatiquement toutes les minutes.
# Aucun worker séparé n'est nécessaire.
QUEUE_CONNECTION=database

# ── Broadcast ─────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ── Mail  Resend ─────────────────────────────────────────────────────────────
MAIL_MAILER=resend
RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS="bookings@gokusafiri.com"
MAIL_FROM_NAME="GokuSafiri"

# Adresse admin qui reçoit les notifications internes (new booking, payments)
ADMIN_EMAIL="admin@gokusafiri.com"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_KEY=pk_live_xxxxxxxxxxxxx
STRIPE_SECRET=sk_live_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ── Google OAuth (si utilisé) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ── Media Library ─────────────────────────────────────────────────────────────
# Les médias Spatie sont stockés dans storage/app/public  le lien symbolique
# doit pointer vers public/storage (créé par: php artisan storage:link)
